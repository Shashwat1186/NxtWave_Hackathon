# ── App ─────────────────────────────────────────────────────────────────────
APP_NAME=CivicTriage
ENV=development
DEBUG=true

# ── IMPORTANT: Set to true during demos if LLM/geo APIs are unavailable ─────
DEMO_MODE=false
DEMO_CACHE_DIR=eval/golden_inputs

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get this from Atlas → Connect → Drivers → Python
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=civictriage

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose: google | openai
LLM_PROVIDER=google
LLM_PRIMARY_MODEL=gemini-1.5-flash
LLM_FALLBACK_MODEL=gemini-1.5-pro
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=3

# Google AI Studio key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# OpenAI key (optional; used if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBED_MODEL=models/gemini-embedding-001
EMBED_DIMENSION=3072

# ── Geo Services ──────────────────────────────────────────────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CivicTriage/1.0 (your@email.com)
OVERPASS_URL=https://overpass-api.de/api/interpreter
GEO_TIMEOUT_SECONDS=10.0
GEO_MAX_RETRIES=2
GEO_CACHE_TTL_HOURS=168

# ── Deduplication ─────────────────────────────────────────────────────────────
DEDUP_GEO_RADIUS_METERS=500.0
DEDUP_SIMILARITY_THRESHOLD=0.82

# ── SLA Hours per severity tier ───────────────────────────────────────────────
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=72
SLA_LOW_HOURS=168

# ── Critic ────────────────────────────────────────────────────────────────────
CRITIC_MAX_RETRIES=2
CRITIC_MIN_CONFIDENCE=0.65

# ── Admin ─────────────────────────────────────────────────────────────────────
# Used as Bearer token for /admin/* and /internal/* endpoints.
ADMIN_TOKEN=civic-admin-secret-2026-pass

# ── CORS & Production URLs ────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# Production frontend URL on Vercel:
FRONTEND_URL=https://civictriage.vercel.app

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

